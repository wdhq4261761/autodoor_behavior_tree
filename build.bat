@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion
echo ========================================
echo AutoDoor Behavior Tree - Unified Build
echo ========================================
echo.

cd /d "%~dp0"

rem NOTE: keep this file ASCII-only.
rem Chinese characters written in UTF-8 can be mis-parsed by cmd.exe
rem (multi-byte sequences may contain bytes cmd treats as operators),
rem which shows up as "'...' is not recognized as an internal command".
rem Any Chinese text that must be produced is generated by python instead.

rem ---- pick interpreter ----
rem Prefer the project venv: deps live there, and PATH python may be
rem a different version without them, which fails the build.
set "PYEXE=venv\Scripts\python.exe"
if not exist "%PYEXE%" (
    echo WARNING: venv not found, falling back to system python.
    set "PYEXE=python"
)
echo Interpreter: %PYEXE%

echo Checking Python environment...
"%PYEXE%" --version
if errorlevel 1 (
    echo Error: Python not found!
    pause
    exit /b 1
)

echo.
echo Checking required modules...
"%PYEXE%" -c "import customtkinter; import rapidocr; import pygame; import PIL; print('All modules OK')"
if errorlevel 1 (
    echo Error: Required modules not installed!
    echo Please run: "%PYEXE%" -m pip install -r requirements.txt
    pause
    exit /b 1
)

echo.
echo Checking PyInstaller...
"%PYEXE%" -c "import PyInstaller" 2>nul
if errorlevel 1 (
    echo PyInstaller not found, installing...
    "%PYEXE%" -m pip install "pyinstaller>=6.0"
    if errorlevel 1 (
        echo Error: Failed to install PyInstaller!
        pause
        exit /b 1
    )
)

echo.
echo Generating build info from build_config.json...
"%PYEXE%" generate_build_info.py
if errorlevel 1 (
    echo Warning: Failed to generate build info, using defaults
)

echo.
echo Starting PyInstaller build (Unified version)...
"%PYEXE%" -m PyInstaller autodoor_bt.spec --clean --noconfirm

if errorlevel 1 (
    echo.
    echo Build failed!
    pause
    exit /b 1
)

rem ---- resolve version via temp file ----
rem Do not use for /f with a quoted command inside backticks: cmd's
rem for /f usebackq mishandles nested double quotes and can swallow
rem the following lines.
"%PYEXE%" -c "import json;print(json.load(open('build_config.json',encoding='utf-8'))['version'])" > "%TEMP%\autodoor_ver.txt" 2>nul
set "VER="
set /p VER=<"%TEMP%\autodoor_ver.txt"
del "%TEMP%\autodoor_ver.txt" >nul 2>&1
if "%VER%"=="" (
    echo Error: failed to read version from build_config.json
    pause
    exit /b 1
)
echo Version: %VER%
set "OUTDIR=dist\autodoor-behaviortree-%VER%"

echo.
echo ========================================
echo Post-processing: %OUTDIR%
echo ========================================
if not exist "%OUTDIR%" (
    echo Error: output dir not found: %OUTDIR%
    pause
    exit /b 1
)

rem ---- copy user plugins next to the exe ----
rem Plugins must sit beside the exe, not inside _internal.
rem get_user_plugin_dir() resolves to <exe dir>\plugins, so users can
rem view/edit/add plugins, and an overwrite upgrade will not wipe them.
if exist "plugins" (
    echo [1/3] Copying plugins to %OUTDIR%\plugins ...
    robocopy "plugins" "%OUTDIR%\plugins" /E /XD __pycache__ /NFL /NDL /NJH /NJS /NP >nul
    if errorlevel 8 (
        echo Error: failed to copy plugins
        pause
        exit /b 1
    )
    echo       plugins copied.
) else (
    echo [1/3] No plugins directory, skipped.
)

rem ---- launcher notes (generated by python, so Chinese text is safe) ----
echo [2/3] Writing launcher notes ...
"%PYEXE%" generate_launcher_notes.py "%VER%" "%OUTDIR%"
if errorlevel 1 (
    echo       WARNING: failed to write launcher notes
) else (
    echo       notes written.
)

rem ---- self check ----
rem Use autodoor-cli.exe, not the GUI exe: the GUI build is console=False
rem and has no stdout handle, so redirection captures nothing.
echo [3/3] Verifying bundled CLI and plugins ...
"%OUTDIR%\autodoor-cli.exe" plugin nodes > "%TEMP%\autodoor_build_check.txt" 2>&1
if errorlevel 1 (
    echo       WARNING: CLI self-check failed, see %TEMP%\autodoor_build_check.txt
) else (
    echo       CLI OK
)
set "FOUND="
for /f "delims=" %%l in ('findstr /c:"vlm_vision" "%TEMP%\autodoor_build_check.txt"') do (
    if not defined FOUND (
        set "FOUND=1"
        echo       plugin detected: %%l
    )
)
if not defined FOUND echo       WARNING: vlm_vision not listed, check plugins copy.

echo.
echo ========================================
echo Build completed successfully!
echo Output: %OUTDIR%
echo ========================================
pause
